<?xml version="1.0"?>

<beans
	default-destroy-method="destroy"
	default-init-method="afterPropertiesSet"
	xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-3.0.xsd"
>
	<bean id="com.liferay.arkadiko.bean.AKBeanPostProcessor" class="com.liferay.arkadiko.bean.AKBeanPostProcessor">
		<property name="excludeBeanNames">
			<list>
				<value>com.liferay.portal.kernel.dao.orm.SessionFactory</value>
			</list>
		</property>
		<property name="includeBeanNames">
			<list>
				<value>*</value>
			</list>
		</property>
		<property name="trackService" value="false" />
		<property name="serviceRegistry">
			<bean class="com.liferay.portal.module.framework.AKServiceRegistry" />
		</property>
	</bean>
</beans>