Bundle-Name: Liferay CAS SSO
Bundle-SymbolicName: com.liferay.sso.cas
Bundle-Version: 1.0.0
Import-Package:\
	${bnd.jsp.support.imports},\
	*
Include-Resource:\
	classes,\
	META-INF/resources=src/META-INF/resources,\
	@lib/cas-client-core.jar,\
	@lib/javax.servlet.jsp.jstl.jar!/META-INF/*.tld,\
	@../../../../util-taglib/util-taglib.jar
