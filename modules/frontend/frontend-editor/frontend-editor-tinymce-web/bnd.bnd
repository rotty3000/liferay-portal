Bundle-Name: Liferay Frontend Editor TinyMCE Web
Bundle-SymbolicName: com.liferay.frontend.editor.tinymce.web
Bundle-Version: 1.0.0
Web-ContextPath: /frontend-editor-tinymce-web

-donotcopy: (\.touch|.*_diffs.*)
-includeresource.bundle:\
	META-INF/resources=src/main/resources/META-INF/resources,\
	META-INF/resources=tmp/META-INF/resources