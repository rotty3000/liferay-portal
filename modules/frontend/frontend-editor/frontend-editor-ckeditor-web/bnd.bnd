Bundle-Name: Liferay Frontend Editor CKEditor Web
Bundle-SymbolicName: com.liferay.frontend.editor.ckeditor.web
Bundle-Version: 1.0.0
Web-ContextPath: /frontend-editor-ckeditor-web

-donotcopy: (\.touch|.*_diffs.*)
-includeresource.bundle:\
	META-INF/resources=src/main/resources/META-INF/resources,\
	META-INF/resources=tmp/META-INF/resources