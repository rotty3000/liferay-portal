Bundle-Name: Liferay Portal HTTP Tunnel Extender
Bundle-SymbolicName: com.liferay.portal.http.tunnel.extender
Bundle-Version: 1.0.0
Conditional-Package:\
	org.apache.felix.utils.extender,\
	org.apache.felix.utils.log
Provide-Capability:\
	liferay.extender;
		liferay.extender="http.tunnel.extender";
		version:Version="${plugin-full-version}"