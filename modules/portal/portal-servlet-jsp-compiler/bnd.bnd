Bundle-Activator: com.liferay.portal.servlet.jsp.compiler.internal.JspFactoryBundleActivator
Bundle-Name: Liferay Portal Servlet JSP Compiler
Bundle-SymbolicName: com.liferay.portal.servlet.jsp.compiler
Bundle-Version: 1.0.0
Conditional-Package: org.apache.felix.utils.log
Export-Package: com.liferay.portal.servlet.jsp.compiler
Provide-Capability:\
	liferay.extender;liferay.extender="jsp.extender";version:Version="${Bundle-Version}"

-includeresource.bundle:\
	@lib/javax.servlet.jsp.jar,\
	@lib/javax.servlet.jsp.jstl.jar!/META-INF/*.tld,\
	@../../../portal-service/portal-service.jar!/com/liferay/portal/kernel/util/ReflectionUtil*.class,\
	@../../../portal-service/portal-service.jar!/com/liferay/portal/kernel/util/StringPool*.class,\
	@../../../portal-service/portal-service.jar!/com/liferay/portal/kernel/util/StringURLCodec*.class,\
	@../../../portal-service/portal-service.jar!/com/liferay/portal/kernel/util/StringUtil*.class,\
	@../../../portal-service/portal-service.jar!/com/liferay/portal/kernel/util/Validator*.class