Bundle-ClassPath: .
Bundle-Name: Liferay Portal CXF Common
Bundle-SymbolicName: com.liferay.portal.cxf.common
Bundle-Version: 1.0.0
Export-Package:\
	javax.wsdl.*,\
	org.apache.cxf.*,\
	org.apache.ws.commons.schema.*
Import-Package:\
	!com.sun.*,\
	!javax.validation.*,\
	!net.sf.cglib.proxy.*,\
	!org.apache.abdera.*,\
	!org.apache.aries.*,\
	!org.apache.cxf.aegis.*,\
	!org.apache.cxf.ws.policy.*,\
	!org.apache.neethi.*,\
	!org.apache.velocity.*,\
	!org.apache.xml.resolver.*,\
	!org.apache.xmlbeans.*,\
	!org.junit.*,\
	!org.jvnet.fastinfoset.*,\
	!org.jvnet.staxex.*,\
	!org.relaxng.datatype.*,\
	!org.osgi.service.blueprint.*,\
	!org.slf4j.spi.*,\
	!org.springframework.*,\
	*

-includeresource.bundle:\
	lib/=lib/cxf-core.jar;lib:=true,\
	lib/=lib/cxf-rt-bindings-soap.jar;lib:=true,\
	lib/=lib/cxf-rt-databinding-jaxb.jar;lib:=true,\
	lib/=lib/cxf-rt-transports-http.jar;lib:=true,\
	lib/=lib/cxf-rt-wsdl.jar;lib:=true,\
	lib/=lib/cxf-tools-common.jar;lib:=true,\
	lib/=lib/cxf-tools-validator.jar;lib:=true,\
	lib/=lib/stax2-api.jar;lib:=true,\
	lib/=lib/woodstox-core-asl.jar;lib:=true,\
	lib/=lib/wsdl4j.jar;lib:=true,\
	lib/=lib/xmlschema-core.jar;lib:=true