Bundle-Name: Liferay Journal Content Web
Bundle-SymbolicName: com.liferay.journal.content.web
Bundle-Version: 1.0.0
Require-SchemaVersion: 1.0.0
Web-ContextPath: /journal-content-web

-includeresource.bundle:\
	META-INF/resources=src/META-INF/resources,\
	@${app-server-lib-portal-dir}/util-java.jar!/com/liferay/util/PropertyComparator.class,\
	@${app-server-lib-portal-dir}/util-java.jar!/com/liferay/util/log4j/Log4JUtil.class