Bundle-Name: Liferay Journal Web
Bundle-SymbolicName: com.liferay.journal.web
Bundle-Version: 1.0.0
Export-Package:\
	com.liferay.journal.web.asset,\
	com.liferay.journal.web.constants,\
	com.liferay.journal.web.ddm,\
	com.liferay.journal.web.social,\
	com.liferay.journal.web.util
-includeresource.bundle:\
	@../../../../util-java/util-java.jar!/com/liferay/util/ContentUtil*.class,\
	@../../../../util-java/util-java.jar!/com/liferay/util/RSSThreadLocal*.class,\
	@../../../../util-java/util-java.jar!/com/liferay/util/RSSUtil*.class
JS-Config: /META-INF/resources/js/config.js
Web-ContextPath: /journal-web