Bundle-Version: 1.0.0
Conditional-Package:\
	com.liferay.util.bean,\
	com.liferay.util.portlet
Export-Package: com.liferay.wiki.web.util
-includeresource.bundle:\
	@../../../../util-java/util-java.jar!/com/liferay/util/RSSUtil*.class
Web-ContextPath: /wiki-web