Bundle-Name: Liferay Shopping Web
Bundle-SymbolicName: com.liferay.shopping.web
Bundle-Version: 1.0.0
Conditional-Package:\
	com.liferay.util.bean,\
	com.liferay.util.portlet
-includeresource.bundle:\
	WEB-INF/classes/=@docroot/WEB-INF/lib/util-java.jar!/com/liferay/util/CreditCard*.class,\
	WEB-INF/classes/=@docroot/WEB-INF/lib/util-java.jar!/com/liferay/util/State*.class,\
	WEB-INF/classes/=@docroot/WEB-INF/lib/util-java.jar!/com/liferay/util/StateUtil*.class
Web-ContextPath: /shopping-web

-donotcopy: (docroot/WEB-INF/src|.*\.jar|.*\.java)
-wab: docroot