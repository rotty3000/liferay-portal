Bundle-Name: Liferay Document Library Repository CMIS Implementation
Bundle-SymbolicName: com.liferay.document.library.repository.cmis.impl
Bundle-Version: 1.0.0
Conditional-Package:\
	com.ctc.wstx.*,\
	org.apache.chemistry.opencmis.*,\
	org.codehaus.stax2.*,\
	wsdl.*
-includeresource.bundle:\
	@lib/chemistry-opencmis-commons-impl.jar!/META-INF/services/*,\
	@lib/woodstox-core-asl.jar!/META-INF/services/*
Import-Package:\
	!org.apache.http.*,\
	*