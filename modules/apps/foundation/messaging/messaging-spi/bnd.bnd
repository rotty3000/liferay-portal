Bundle-Name: Liferay Messaging SPI
Bundle-SymbolicName: com.liferay.messaging.spi
Bundle-Version: 1.0.0
Export-Package:\
	com.liferay.messaging.spi,\
	com.liferay.messaging.spi.proxy,\
	com.liferay.messaging.spi.sender
Liferay-Releng-Module-Group-Description:
Liferay-Releng-Module-Group-Title:
Provide-Capability:\
	osgi.service;\
		objectClass:List<String>="org.osgi.service.component.ComponentFactory"
Require-Capability:\
	osgi.implementation;\
		filter:="(&(osgi.implementation=com.liferay.messaging)(version>=1.0.0)(!(version>=2.0.0)))"
-dsannotations-options: inherit