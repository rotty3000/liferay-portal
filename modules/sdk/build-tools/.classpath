<?xml version="1.0" encoding="UTF-8"?>
<classpath>
	<classpathentry excluding="**/.svn/**|.svn/" kind="src" path="src"/>
	<classpathentry kind="src" path="test"/>
	<classpathentry kind="src" path="/portal-master"/>
	<classpathentry kind="con" path="org.eclipse.jdt.launching.JRE_CONTAINER"/>
	<classpathentry kind="lib" path="/portal-master/lib/development/derbytools.jar"/>
	<classpathentry kind="lib" path="/portal-master/lib/development/deployment.jar"/>
	<classpathentry kind="lib" path="/portal-master/lib/development/jalopy.jar"/>
	<classpathentry kind="lib" path="/portal-master/lib/development/jargs.jar"/>
	<classpathentry kind="lib" path="/portal-master/lib/development/junit.jar"/>
	<classpathentry kind="lib" path="/portal-master/lib/development/qdox.jar"/>
	<classpathentry kind="lib" path="/portal-master/lib/development/servlet-api.jar"/>
	<classpathentry kind="lib" path="/portal-master/lib/global/portlet.jar"/>
	<classpathentry kind="lib" path="/portal-master/lib/portal/ant.jar"/>
	<classpathentry kind="lib" path="/portal-master/lib/portal/aopalliance.jar"/>
	<classpathentry kind="lib" path="/portal-master/lib/portal/bnd.jar"/>
	<classpathentry kind="lib" path="/portal-master/lib/portal/commons-configuration.jar"/>
	<classpathentry kind="lib" path="/portal-master/lib/portal/commons-io.jar"/>
	<classpathentry kind="lib" path="/portal-master/lib/portal/commons-lang.jar"/>
	<classpathentry kind="lib" path="/portal-master/lib/portal/dom4j.jar"/>
	<classpathentry kind="lib" path="/portal-master/lib/portal/freemarker.jar"/>
	<classpathentry kind="lib" path="/portal-master/lib/portal/jruby.jar"/>
	<classpathentry kind="output" path="bin"/>
</classpath>
