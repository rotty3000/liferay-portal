Bundle-Name: Http Adaptor
Bundle-Version: 1.0.0
Export-Package: *
Import-Package:\
	javax.servlet.http;version="[2.3.0,4.0.0)",\
	org.eclipse.equinox.http.servlet;version="[1.1.0,2.0)",\
	org.osgi.framework;version="[1.3,2.0)",\
	org.osgi.service.component;version="[1.2,2.0)",\
	*
Include-Resource: build/classes/main