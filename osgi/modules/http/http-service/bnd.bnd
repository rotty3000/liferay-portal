Bundle-Name: Http Service 1.3
Export-Package:\
	com.liferay.osgi.util;version="1.0.0",\
	org.osgi.service.http.runtime;version="1.3",\
	org.osgi.service.http;version="1.3"
Import-Package:\
	aQute.lib.converter;version="[2.0.1,3.0)",\
	org.osgi.framework;version="[1.6,2.0)",\
	org.osgi.framework.wiring;version="[1.0,2.0)",\
	org.osgi.service.component;version="[1.1,2.0)",\
	org.osgi.service.http.runtime;version="[1.3,1.4)",\
	org.osgi.service.http;version="[1.3,1.4)",\
	org.osgi.dto;version="[1.0,2.0)",\
	javax.servlet,\
	javax.servlet.descriptor,\
	javax.servlet.http
Include-Resource: build/classes/main
Private-Package: com.liferay.osgi.http.internal.*
Provide-Capability: \
	osgi.whiteboard; osgi.whiteboard="osgi.http"; uses:="javax.servlet,\
		javax.servlet.http"; version:Version="1.3"
Service-Component: com.liferay.osgi.http.internal.*