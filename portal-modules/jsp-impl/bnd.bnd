	javax.servlet.jsp.resources;version="2.1",\
	javax.servlet.jsp.*;version="2.1",\
	org.apache.jasper.*;vendor=glassfish;version="6.0.0",\
	org.glassfish.jsp.api;vendor=glassfish;version="6.0.0"
