Export-Package: \
	com.liferay.web.extender.servlet
Import-Package: \
	com.liferay.web.extender.servlet,\
	*
Include-Resource: classes
Private-Package: \
	com.liferay.web.extender.internal.*,\
	org.objectweb.asm.depend